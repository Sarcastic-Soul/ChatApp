# ChatApp architecture. Render with:
#   d2 docs/architecture.d2 docs/architecture.svg
vars: {
  d2-config: {
    theme-id: 302
    layout-engine: elk
    pad: 40
  }
}

direction: down

users: People {
  shape: person
}

browser: Browser {
  spa: "React 19 SPA\nMantine 9 · Zustand 5 · Motion"
  e2ee: "Web Crypto\nECDH P-256 keys · AES-GCM"
  cache: "IndexedDB\nchat cache · outbox · private key" {shape: cylinder}
  sw: "Service worker\npush notifications"
  rtc: WebRTC peer
  spa -> e2ee: "encrypt and decrypt\nmessages"
  spa -> cache: "offline copy of chats,\nunsent messages"
  spa -> rtc: calls
}

peer: Other browser {
  rtc: WebRTC peer
}

stun: "Google STUN\nCloudflare TURN"

push: "Browser push service\nGoogle · Mozilla · Apple"

vercel: Vercel {
  static: "Static build\nVite 8"
  rewrite: "/api/* rewrite"
}

render: Render · Node 22 {
  api: "Express 5 API\nhelmet · CORS · rate limit\nJWT cookie auth · zod checks"
  io: "Socket.io server\nsocket token auth · zod checks\nuser and group rooms"
  crypto: "AES-256 at rest for text\nthe server can read\nsearch hashes · profanity filter"
  api -> crypto
  api -> io: "push new messages,\nedits, reactions"
}

cron: "GitHub Actions\ntests, then deploy hook\nkeep-alive every 10 min"

redis: "Redis (optional)\njoins several servers" {
  shape: cylinder
}

atlas: "MongoDB Atlas\nMongoose 9" {
  shape: cylinder
}

cloudinary: "Cloudinary\nimages · video · voice notes"

groq: "Groq API\nopenai/gpt-oss-120b"

users -> browser.spa
browser.spa -> vercel.static: load app
browser.spa -> vercel.rewrite: "HTTPS + auth cookie"
vercel.rewrite -> render.api: proxy
browser.spa <-> render.io: WebSocket {
  style.stroke-dash: 4
}
browser.spa -> cloudinary: signed upload
render.api -> cloudinary: sign upload {
  style.stroke-dash: 4
}
render.api -> atlas: "ciphertext, sealed chat keys,\nsequence numbers"
render.io -> atlas: group membership
render.api -> groq: magic reply
browser.rtc <-> peer.rtc: audio and video {
  style.stroke-width: 3
}
browser.rtc -> stun: "find public address,\nrelay if blocked"
peer.rtc -> stun
cron -> render.api: "GET /healthz"
render.api -> push: Web Push (VAPID)
push -> browser.sw: "New message"
render.io <-> redis: "socket events,\nonline status" {
  style.stroke-dash: 4
}
