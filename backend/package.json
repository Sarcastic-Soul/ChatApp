{
  "name": "mern-chat-backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "packageManager": "pnpm@12.4.2",
  "main": "server.ts",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.ts",
    "dev": "node --watch --env-file-if-exists=.env server.ts",
    "seed": "node --env-file-if-exists=.env seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "backfill:search": "node --env-file-if-exists=.env scripts/backfill-search-index.ts",
    "typecheck": "tsc -p . && tsc -p tests"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "leo-profanity": "^1.9.0",
    "mongoose": "^9.10.3",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.4",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "mongodb-memory-server-core": "^11.3.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
